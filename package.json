{
  "name": "dsh-image-viewer-fl0wer",
  "version": "0.1.17",
  "description": "WSL043's MIT DSH image viewer, distributed with documented community modifications",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "image-viewer",
    "lightbox",
    "zoom",
    "annotation"
  ],
  "author": "WSL043 (original project); fl0-0wer (fork modifications)",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "assets/icon.svg",
    "locale/*.json",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "MODIFICATIONS.md",
    "compatibility.json",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/verify-prebuilt.mjs",
    "PATCHES/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fl0-0wer/dsh-image-viewer-fl0wer.git"
  },
  "bugs": {
    "url": "https://github.com/fl0-0wer/dsh-image-viewer-fl0wer/issues"
  },
  "homepage": "https://github.com/fl0-0wer/dsh-image-viewer-fl0wer#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2 || 4.0.3 || 4.0.4 || 4.0.5-alpha.1 || 4.0.5-alpha.2 || 4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.1-alpha.5 || 0.2.1-alpha.4 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.1-alpha.5 || 0.2.1-alpha.4 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.1-alpha.5 || 0.2.1-alpha.4 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.1-alpha.5 || 0.2.1-alpha.4 || 0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "verify": "node scripts/verify-prebuilt.mjs"
  }
}
